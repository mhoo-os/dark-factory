{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mhoo-dark-factory-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "FACTORY_ENABLED": "false",
    "FACTORY_AUTONOMY": "0",
    "AUTO_MERGE": "false",
    "LINEAR_PROJECT_ID": "",
    "LINEAR_PROJECT_SLUG": "mhoo-dark-factory-cloudflare-control-plane-and-autonomous-execution-3f3e004db3a7",
    "ALLOWED_REPOSITORY_PREFIX": "mhoo-os/",
    "SANDBOX_COMMAND": "node /opt/mhoo-factory-agent.mjs",
    "OPENROUTER_MODEL": ""
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "mhoo-dark-factory-ledger",
    "database_id": "e76d5f65-a33c-41cf-9f82-622c1d53cf43",
    "migrations_dir": "migrations"
  }],
  "queues": {
    "producers": [{
      "binding": "EXECUTION_QUEUE",
      "queue": "mhoo-dark-factory-execution"
    }],
    "consumers": [{
      "queue": "mhoo-dark-factory-execution",
      "max_batch_size": 1,
      "max_batch_timeout": 5,
      "max_retries": 3,
      "dead_letter_queue": "mhoo-dark-factory-execution-dlq",
      "max_concurrency": 1
    }]
  },
  "workflows": [{
    "name": "mhoo-dark-factory-execution",
    "binding": "EXECUTION_WORKFLOW",
    "class_name": "ExecutionWorkflow",
    "limits": { "steps": 100 }
  }],
  "containers": [{
    "class_name": "Sandbox",
    "image": "./Dockerfile",
    "instance_type": "lite",
    "max_instances": 1
  }],
  "durable_objects": { "bindings": [{ "name": "Sandbox", "class_name": "Sandbox" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sandbox"] }],
  "triggers": { "crons": ["*/5 * * * *"] }
}

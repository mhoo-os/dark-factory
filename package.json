{
  "name": "mhoo-dark-factory-control-plane",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "wrangler types && tsc --noEmit",
    "build": "wrangler deploy --dry-run --containers-rollout=none",
    "test:python": "python3 -m unittest discover -s tests -v",
    "test:sandbox": "node --test tests/sandbox-agent.test.mjs",
    "test:native": "node --test --experimental-test-coverage --test-coverage-include=src/native-candidate.ts --test-coverage-include=native/mock-codex-runner.mjs --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=95 tests/native-candidate.test.mjs tests/native-codex-runner.test.mjs",
    "test:contract": "node --test tests/d1-migration-sequence.test.mjs tests/chat-lane-registry.test.mjs tests/worker-contract.test.mjs tests/worker-dry-run-execution.test.mjs",
    "test:worker": "vitest run",
    "test": "npm run test:python && npm run test:sandbox && npm run test:contract && npm run test:worker",
    "test:native-policy": "node --test --experimental-test-coverage --test-coverage-include=native/launch-policy.mjs --test-coverage-include=native/containment-contract.mjs --test-coverage-include=native/codex-jsonl.mjs --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=95 tests/native-launch-policy.test.mjs tests/containment-contract.test.mjs tests/codex-jsonl.test.mjs",
    "test:coverage": "npm run test:repair-loop && npm run test:review-pair && npm run test:native-policy && npm run test:native && npm run test:contract && vitest run --coverage",
    "test:review-pair": "node --test --experimental-test-coverage --test-coverage-include=src/review-pair.ts --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=95 tests/review-pair.test.mjs",
    "test:repair-loop": "node --test --experimental-test-coverage --test-coverage-include=src/repair-continuation.ts --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=95 tests/repair-continuation.test.mjs"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.9"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.3",
    "@types/node": "26.4.1",
    "@vitest/coverage-istanbul": "^4.1.11",
    "typescript": "5.9.2",
    "vitest": "^4.1.11",
    "wrangler": "4.128.0"
  }
}

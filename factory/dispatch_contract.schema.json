{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mhoo.app/schemas/factory-dispatch-contract-v1.json",
  "title": "Mhoo Factory Dispatch Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "dispatch_id", "linear", "target", "dependencies", "risk", "acceptance_criteria", "validation_profile", "allowed_scope", "merge_policy", "stale_conditions"],
  "properties": {
    "contract_version": {"const": "v1"},
    "dispatch_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,191}$"},
    "linear": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "issue_id", "identifier", "planning_revision", "planning_fingerprint"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1}, "issue_id": {"type": "string", "minLength": 1},
        "identifier": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,9}-[1-9][0-9]*$"},
        "planning_revision": {"type": "string", "minLength": 1}, "planning_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "work_type", "execution_profile", "collision_group", "base_sha"],
      "properties": {
        "repository": {"type": "string", "pattern": "^mhoo-os/[a-z0-9][a-z0-9._-]{0,99}$"}, "work_type": {"type": "string", "minLength": 1},
        "execution_profile": {"type": "string", "minLength": 1}, "collision_group": {"type": "string", "minLength": 1}, "base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
      }
    },
    "dependencies": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["issue_id", "required_state"], "properties": {"issue_id": {"type": "string"}, "required_state": {"const": "completed"}}}},
    "risk": {"type": "object", "additionalProperties": false, "required": ["risk_class", "authority_class"], "properties": {"risk_class": {"enum": ["low", "medium", "high"]}, "authority_class": {"enum": ["repository-local", "cross-system"]}}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "validation_profile": {"type": "string", "minLength": 1},
    "allowed_scope": {"type": "object", "additionalProperties": false, "required": ["paths", "max_files", "max_changed_lines"], "properties": {"paths": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "max_files": {"type": "integer", "minimum": 1}, "max_changed_lines": {"type": "integer", "minimum": 1}}},
    "merge_policy": {"enum": ["human", "auto-eligible"]},
    "stale_conditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["planning_revision_changed", "planning_fingerprint_changed", "base_sha_changed"]}},
    "factory_request": {"type": "object", "additionalProperties": false, "properties": {"credential_profile": {"type": "string", "minLength": 1}, "concurrency": {"type": "integer", "minimum": 1}, "model_policy_key": {"type": "string", "minLength": 1}, "escalation_class": {"type": "string", "minLength": 1}, "effect_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "registry": {"type": "object", "additionalProperties": false, "required": ["factory_id", "registry_version", "registry_digest", "entry_version"], "properties": {"factory_id": {"type": "string", "minLength": 1}, "registry_version": {"type": "string", "minLength": 1}, "registry_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "entry_version": {"type": "string", "minLength": 1}}}
  }
}
